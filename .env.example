# انسخ هذا الملف إلى .env وضع مفتاحك (أو الصقه من شاشة الإعدادات داخل التطبيق)
DEEPSEEK_API_KEY=
# deepseek-chat (سريع) أو deepseek-reasoner (تفكير أعمق وأبطأ)
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

PORT=3000
# 127.0.0.1 = متاح من جهازك فقط (أأمن). استخدم 0.0.0.0 لو بدك تفتحه من الموبايل على نفس الشبكة
HOST=127.0.0.1

# كلمة مرور لحماية التطبيق عند رفعه على استضافة عامة (تظهر شاشة دخول قبل فتح التطبيق)
APP_PASSWORD=

# MOCK=1 يشغّل وضع التجربة بدون أي اتصال بالذكاء الاصطناعي
MOCK=
